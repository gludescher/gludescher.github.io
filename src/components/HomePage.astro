---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Nav from "./Nav.astro";
import Hero from "./Hero";
import ProjectCard from "./ProjectCard";
import Reveal from "./Reveal.astro";
import { site, profile } from "../data/site";
import { getLocale, localePath, useTranslations } from "../i18n";

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const p = profile[locale];

const projects = (await getCollection("projects", (e) => e.id.startsWith(`${locale}/`))).sort(
  (a, b) => a.data.order - b.data.order,
);
const slug = (id: string) => id.split("/").slice(1).join("/");
---

<Layout>
  <Nav />
  <main>
    <Hero
      client:load
      name={site.name}
      title={p.title}
      tagline={p.tagline}
      photo={site.photo}
      cvHref={site.cv[locale]}
      labels={{
        greeting: t("hero.greeting"),
        viewProjects: t("hero.viewProjects"),
        getInTouch: t("hero.getInTouch"),
        portraitAlt: t("hero.portraitAlt"),
        downloadCv: t("hero.downloadCv"),
      }}
    />

    <section id="projects" class="mx-auto max-w-5xl scroll-mt-16 px-6 py-16 md:py-20">
      <Reveal>
        <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">{t("projects.title")}</h2>
        <p class="mt-3 max-w-xl text-muted">{t("projects.subtitle")}</p>
      </Reveal>
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {
          projects.map((proj, i) => (
            <Reveal class="h-full" delay={i * 0.08}>
              <ProjectCard
                client:idle
                title={proj.data.title}
                kind={proj.data.kind}
                summary={proj.data.summary}
                stack={proj.data.stack}
                href={localePath(locale, `/projects/${slug(proj.id)}/`)}
                cta={t("projects.readMore")}
              />
            </Reveal>
          ))
        }
      </div>
    </section>

    <section id="experience" class="mx-auto max-w-5xl scroll-mt-16 px-6 py-16 md:py-20">
      <Reveal>
        <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">{t("experience.title")}</h2>
      </Reveal>
      <ol class="mt-12 space-y-10 border-l border-border pl-8">
        {
          p.experience.map((job, i) => (
            <li class="relative">
              <span class="absolute top-1.5 -left-[2.35rem] h-3 w-3 rounded-full border-2 border-accent bg-bg" />
              <Reveal delay={i * 0.05}>
                <p class="font-mono text-xs tracking-widest text-accent-2 uppercase">{job.period}</p>
                <h3 class="mt-1 font-display text-xl font-semibold">
                  {job.role} <span class="text-muted">· {job.company}</span>
                </h3>
                <ul class="mt-3 list-disc space-y-1 pl-5 text-muted marker:text-border">
                  {job.points.map((pt) => (
                    <li>{pt}</li>
                  ))}
                </ul>
                <ul class="mt-4 flex flex-wrap gap-2">
                  {job.stack.map((s) => (
                    <li class="rounded-full border border-border px-3 py-1 font-mono text-xs text-muted">{s}</li>
                  ))}
                </ul>
              </Reveal>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="about" class="mx-auto max-w-5xl scroll-mt-16 px-6 py-16 md:py-20">
      <Reveal>
        <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">{t("about.title")}</h2>
      </Reveal>
      <div class="mt-10 grid gap-12 md:grid-cols-[1.2fr_1fr]">
        <div class="space-y-4 text-lg text-muted">
          {p.about.map((para) => <p>{para}</p>)}
        </div>
        <div class="space-y-6">
          {
            p.skills.map((g) => (
              <div>
                <h3 class="font-mono text-xs tracking-widest text-accent-2 uppercase">{g.group}</h3>
                <ul class="mt-2 flex flex-wrap gap-2">
                  {g.items.map((s) => (
                    <li class="rounded-full border border-border bg-surface px-3 py-1 text-sm">{s}</li>
                  ))}
                </ul>
              </div>
            ))
          }
          <div>
            <h3 class="font-mono text-xs tracking-widest text-accent-2 uppercase">{t("about.languages")}</h3>
            <p class="mt-2 text-sm text-muted">
              {p.languages.map((l) => `${l.name} (${l.level})`).join(" · ")}
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="contact" class="mx-auto max-w-5xl scroll-mt-16 px-6 pt-16 pb-24 md:pt-20">
      <Reveal>
        <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">{t("contact.title")}</h2>
        <p class="mt-4 max-w-xl text-muted">{t("contact.text")} {p.location}.</p>
        <a
          href={site.links.email}
          target="_blank" rel="noopener noreferrer"
          class="mt-8 inline-block rounded-full bg-fg px-6 py-3 text-sm font-medium text-bg transition hover:scale-105"
        >
          {t("contact.cta")}
        </a>
        <div class="mt-8 flex gap-6 text-sm">
          <a class="text-accent-2 hover:underline" href={site.links.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          <a class="text-accent-2 hover:underline" href={site.links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
        </div>
      </Reveal>
    </section>
  </main>
  <footer class="border-t border-border py-8 text-center text-sm text-muted">
    © {new Date().getFullYear()} {site.name}
  </footer>
</Layout>
