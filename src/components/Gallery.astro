---
import { getLocale, useTranslations } from "../i18n";

interface Props {
  images: { src: string; alt: string }[];
  note?: string;
}

const { images, note } = Astro.props;
const t = useTranslations(getLocale(Astro.url));
---

<div class="my-10">
<div class="grid gap-4 sm:grid-cols-2" data-gallery>
  {
    images.map((img, i) => {
      // First image is full width; so is the last one if it would sit alone in its row.
      const wide = i === 0 || (i === images.length - 1 && (images.length - 1) % 2 === 1);
      return (
        <a
          href={img.src}
          data-lightbox={i}
          aria-label={`${t("lightbox.open")}: ${img.alt}`}
          class={`group block cursor-zoom-in overflow-hidden rounded-xl border border-border transition hover:border-accent focus-visible:border-accent focus-visible:outline-none ${wide ? "sm:col-span-2" : ""}`}
        >
          <img
            src={img.src}
            alt={img.alt}
            loading={i < 2 ? "eager" : "lazy"}
            class="w-full transition duration-500 group-hover:scale-[1.02]"
          />
        </a>
      );
    })
  }
</div>
{note && <p class="mt-3 text-center text-xs text-muted">{note}</p>}
</div>

<dialog
  id="lightbox"
  aria-label={images[0]?.alt}
  class="lightbox fixed inset-0 m-0 h-dvh max-h-none w-screen max-w-none bg-transparent p-0 text-fg"
>
  <div class="flex h-full w-full flex-col items-center justify-center gap-4 px-4 py-16 sm:px-20" data-close-area>
    <img data-lightbox-img src={images[0]?.src} alt={images[0]?.alt} class="max-h-full max-w-full rounded-lg object-contain shadow-2xl" />
    <div class="text-center text-sm text-white/80">
      <span data-lightbox-caption>{images[0]?.alt}</span>
      <span class="ml-2 font-mono text-xs text-white/50" data-lightbox-counter></span>
    </div>
  </div>

  <button type="button" data-lightbox-close aria-label={t("lightbox.close")} class="lb-btn top-4 right-4">
    <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
  </button>
  {
    images.length > 1 && (
      <>
        <button type="button" data-lightbox-prev aria-label={t("lightbox.prev")} class="lb-btn top-1/2 left-4 -translate-y-1/2">
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6" /></svg>
        </button>
        <button type="button" data-lightbox-next aria-label={t("lightbox.next")} class="lb-btn top-1/2 right-4 -translate-y-1/2">
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
        </button>
      </>
    )
  }
</dialog>

<style>
  .lightbox::backdrop {
    background: rgb(3 4 10 / 0.88);
    backdrop-filter: blur(6px);
  }
  .lightbox[open],
  .lightbox[open]::backdrop {
    animation: lb-fade 200ms ease-out;
  }
  .lightbox[open] [data-lightbox-img] {
    animation: lb-zoom 250ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  @keyframes lb-fade {
    from { opacity: 0; }
  }
  @keyframes lb-zoom {
    from { opacity: 0; transform: scale(0.96); }
  }
  @media (prefers-reduced-motion: reduce) {
    .lightbox[open],
    .lightbox[open]::backdrop,
    .lightbox[open] [data-lightbox-img] {
      animation: none;
    }
  }
  .lb-btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    color: white;
    background: rgb(255 255 255 / 0.08);
    border: 1px solid rgb(255 255 255 / 0.15);
    transition: background 150ms;
  }
  .lb-btn:hover,
  .lb-btn:focus-visible {
    background: rgb(255 255 255 / 0.18);
    outline: none;
  }
  :global(html:has(dialog.lightbox[open])) {
    overflow: hidden;
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("#lightbox");
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-gallery] [data-lightbox]")];

  if (dialog && links.length) {
    const img = dialog.querySelector<HTMLImageElement>("[data-lightbox-img]")!;
    const caption = dialog.querySelector<HTMLElement>("[data-lightbox-caption]")!;
    const counter = dialog.querySelector<HTMLElement>("[data-lightbox-counter]")!;
    const slides = links.map((a) => {
      const thumb = a.querySelector("img")!;
      return { src: thumb.getAttribute("src")!, alt: thumb.alt };
    });
    let current = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      current = (i + slides.length) % slides.length;
      const { src, alt } = slides[current];
      img.src = src;
      img.alt = alt;
      caption.textContent = alt;
      dialog.setAttribute("aria-label", alt);
      counter.textContent = slides.length > 1 ? `${current + 1} / ${slides.length}` : "";
    };

    links.forEach((a, i) =>
      a.addEventListener("click", (e) => {
        // Let modified clicks open the image in a new tab as usual.
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
        e.preventDefault();
        opener = a;
        show(i);
        dialog.showModal();
      }),
    );

    dialog.addEventListener("close", () => opener?.focus());
    dialog.querySelector("[data-lightbox-close]")?.addEventListener("click", () => dialog.close());
    dialog.querySelector("[data-lightbox-prev]")?.addEventListener("click", () => show(current - 1));
    dialog.querySelector("[data-lightbox-next]")?.addEventListener("click", () => show(current + 1));

    // Clicking anywhere outside the image closes it.
    dialog.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (target === dialog || target.hasAttribute("data-close-area")) dialog.close();
    });

    dialog.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") show(current - 1);
      if (e.key === "ArrowRight") show(current + 1);
    });

    // Swipe left/right on touch screens.
    let startX: number | null = null;
    dialog.addEventListener("touchstart", (e) => (startX = e.touches[0].clientX), { passive: true });
    dialog.addEventListener("touchend", (e) => {
      if (startX === null) return;
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
      startX = null;
    });
  }
</script>
