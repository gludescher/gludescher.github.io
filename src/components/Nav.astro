---
import { site } from "../data/site";
import { alternatePath, getLocale, localePath, useTranslations } from "../i18n";

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const home = localePath(locale, "/");
const alt = alternatePath(Astro.url);
const links = [
  { id: "projects", label: t("nav.projects") },
  { id: "experience", label: t("nav.experience") },
  { id: "about", label: t("nav.about") },
  { id: "contact", label: t("nav.contact") },
];
const pill =
  "inline-flex h-8 w-11 items-center justify-center rounded-full border border-border transition hover:border-accent hover:text-fg";
---

<header class="fixed inset-x-0 top-0 z-50 transform-gpu border-b border-border/60 bg-bg/70 backdrop-blur-md">
  <nav class="mx-auto flex max-w-5xl items-center justify-between gap-3 px-4 py-3 sm:px-6 sm:py-4">
    <a
      id="home-link"
      href={home}
      class="flex shrink-0 items-center gap-2.5 font-display text-sm font-semibold tracking-tight whitespace-nowrap sm:text-base"
    >
      <img src="/favicon.svg" alt="" width="28" height="28" class="h-7 w-7" />
      {site.name}
    </a>
    <div class="flex items-center gap-6 text-sm text-muted">
      <div class="hidden items-center gap-6 sm:flex">
        {
          links.map((l) => (
            <a class="transition hover:text-fg" data-section={l.id} href={`${home}#${l.id}`}>
              {l.label}
            </a>
          ))
        }
      </div>
      <div class="flex items-center gap-2">
        <a
          id="lang-switch"
          href={alt.href}
          hreflang={alt.locale === "pt" ? "pt-BR" : "en"}
          aria-label={t("nav.language")}
          title={t("nav.language")}
          class={`${pill} pt-[3px] font-mono text-xs leading-none`}
        >
          {alt.locale.toUpperCase()}
        </a>
        <button
          id="theme-toggle"
          type="button"
          aria-label={t("nav.theme")}
          title={t("nav.theme")}
          class={`${pill} text-sm leading-none`}
        >
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor" stroke="none"></path>
          </svg>
        </button>
        <button
          id="menu-toggle"
          type="button"
          aria-label={t("nav.menu")}
          aria-expanded="false"
          aria-controls="mobile-menu"
          class={`${pill} sm:hidden`}
        >
          <svg
            viewBox="0 0 24 24"
            class="size-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path id="menu-icon-open" d="M4 7h16M4 12h16M4 17h16"></path>
            <path id="menu-icon-close" d="M6 6l12 12M18 6L6 18" class="hidden"></path>
          </svg>
        </button>
      </div>
    </div>
  </nav>
  <div id="mobile-menu" hidden class="border-t border-border/60 sm:hidden">
    <ul class="mx-auto max-w-5xl px-4 py-2">
      {
        links.map((l) => (
          <li>
            <a class="block rounded-lg px-2 py-3 text-base text-muted transition hover:text-fg" data-section={l.id} href={`${home}#${l.id}`}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  // On the home page, the logo scrolls back to the hero instead of reloading.
  document.getElementById("home-link")?.addEventListener("click", (e) => {
    const a = e.currentTarget as HTMLAnchorElement;
    if (new URL(a.href).pathname !== location.pathname) return;
    e.preventDefault();
    window.scrollTo({ top: 0, behavior: "smooth" });
    history.replaceState(null, "", location.pathname + location.search);
  });

  // Highlight the nav links of the section currently on screen (home page only).
  const navLinks = new Map<string, HTMLAnchorElement[]>();
  document.querySelectorAll<HTMLAnchorElement>("a[data-section]").forEach((a) => {
    const id = a.dataset.section!;
    navLinks.set(id, [...(navLinks.get(id) ?? []), a]);
  });
  const sections = [...navLinks.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);
  if (sections.length > 0) {
    const update = () => {
      const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
      let current: string | null = atBottom ? sections[sections.length - 1].id : null;
      if (!atBottom) {
        const line = window.innerHeight * 0.4;
        for (const s of sections) if (s.getBoundingClientRect().top <= line) current = s.id;
      }
      navLinks.forEach((anchors, id) => {
        for (const a of anchors) {
          a.classList.toggle("text-accent", id === current);
          if (id === current) a.setAttribute("aria-current", "true");
          else a.removeAttribute("aria-current");
        }
      });
    };
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    window.addEventListener("pageshow", update);
    update();
  }

  // Mobile menu.
  const menu = document.getElementById("mobile-menu");
  const toggle = document.getElementById("menu-toggle");
  const setMenu = (open: boolean) => {
    if (!menu || !toggle) return;
    menu.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
    document.getElementById("menu-icon-open")?.classList.toggle("hidden", open);
    document.getElementById("menu-icon-close")?.classList.toggle("hidden", !open);
  };
  toggle?.addEventListener("click", () => setMenu(menu?.hidden === true));
  menu?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) setMenu(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setMenu(false);
  });
  document.addEventListener("click", (e) => {
    if (!(e.target as HTMLElement).closest("header")) setMenu(false);
  });
  window.addEventListener("resize", () => {
    if (window.innerWidth >= 640) setMenu(false);
  });

  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {}
  });

  // Keep the reader on the same section when switching language.
  document.getElementById("lang-switch")?.addEventListener("click", (e) => {
    const a = e.currentTarget as HTMLAnchorElement;
    if (location.hash) a.href = a.href.split("#")[0] + location.hash;
  });
</script>
