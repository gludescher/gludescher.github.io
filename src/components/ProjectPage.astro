---
import { render, type CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Nav from "./Nav.astro";
import AfterFirstSection from "./AfterFirstSection.astro";
import Gallery from "./Gallery.astro";
import { site } from "../data/site";
import { getLocale, localePath, useTranslations } from "../i18n";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const { Content } = await render(project);
const { title, summary, kind, stack, repos, live, images, imagesNote } = project.data;
---

<Layout title={`${title} · ${site.name}`} description={summary}>
  <Nav />
  <main class="mx-auto max-w-3xl px-6 pt-32 pb-24">
    <a href={`${localePath(locale, "/")}#projects`} class="text-sm text-muted transition hover:text-fg">
      {t("projects.back")}
    </a>
    <p class="mt-8 font-mono text-xs tracking-widest text-accent-2 uppercase">{kind}</p>
    <h1 class="mt-3 font-display text-5xl font-bold tracking-tight sm:text-6xl">{title}</h1>
    <p class="mt-5 text-xl text-muted">{summary}</p>

    <ul class="mt-6 flex flex-wrap gap-2">
      {stack.map((s) => <li class="rounded-full border border-border px-3 py-1 font-mono text-xs text-muted">{s}</li>)}
    </ul>
    <div class="mt-6 flex flex-wrap gap-5 text-sm">
      {repos.map((r) => <a class="text-accent-2 hover:underline" href={r.url} target="_blank" rel="noopener noreferrer">{r.label} ↗</a>)}
      {repos.length === 0 && (
        <p class="text-muted">
          {t("projects.privateCode")}{" "}
          <a class="text-accent-2 hover:underline" href={site.links.email} target="_blank" rel="noopener noreferrer">
            {t("projects.requestCode")}
          </a>
        </p>
      )}
      {live && <a class="text-accent-2 hover:underline" href={live} target="_blank" rel="noopener noreferrer">{t("projects.live")} ↗</a>}
    </div>

    <article class="prose-case mt-12">
      {/* Screenshots go right after the first section ("The problem"). */}
      <AfterFirstSection>
        <Content />
        {images.length > 0 && <Gallery slot="insert" images={images} note={imagesNote} />}
      </AfterFirstSection>
    </article>
  </main>
</Layout>
