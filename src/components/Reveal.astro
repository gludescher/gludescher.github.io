---
// Fades and slides its content in when it scrolls into view.
// The content is visible by default: the script below only hides blocks that are still
// below the fold, and reveals them from plain scroll checks, so nothing can stay invisible
// if JavaScript is slow or the page is restored from the browser cache (Safari).
interface Props {
  delay?: number;
  class?: string;
}
const { delay = 0, class: className } = Astro.props;
---

<div data-reveal class={className} style={`--reveal-delay:${delay}s`}><slot /></div>

<script>
  const blocks = [...document.querySelectorAll<HTMLElement>("[data-reveal]")];
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (blocks.length > 0 && !reduceMotion) {
    const pending = new Set<HTMLElement>();
    const check = () => {
      for (const el of pending) {
        const r = el.getBoundingClientRect();
        if (r.top < window.innerHeight - 60) {
          el.classList.remove("reveal-pending");
          pending.delete(el);
        }
      }
    };
    for (const el of blocks) {
      if (el.getBoundingClientRect().top >= window.innerHeight - 60) {
        el.classList.add("reveal-pending");
        pending.add(el);
      }
    }
    window.addEventListener("scroll", check, { passive: true });
    window.addEventListener("resize", check);
    window.addEventListener("pageshow", check);
    window.addEventListener("load", () => setTimeout(check, 200));
  }
</script>
